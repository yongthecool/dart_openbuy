# OpenDART API 키 (https://opendart.fss.or.kr 에서 무료 신청)
DART_API_KEY=your_opendart_api_key_here

# Telegram Bot 설정 (@BotFather 에서 봇 생성 후 토큰 획득)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram 수신자 Chat ID (@userinfobot 등에서 본인 ID 확인)
TELEGRAM_CHAT_ID=your_chat_id_here

# 확인 주기(초 단위, 기본값: 60초)
CHECK_INTERVAL_SECONDS=60

# 감시할 키워드 (쉼표 구분)
SEARCH_KEYWORDS=공개매수

# 봇 시작 시 안내 메시지 전송 여부 (True / False)
SEND_STARTUP_MESSAGE=True
